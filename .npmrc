# eslint-config-next referencia sus plugins por nombre, y el arbol estricto de
# pnpm no los expone en la raiz: sin esto `pnpm lint` falla nada mas clonar con
# "couldn't find the plugin", que es un gate que en la practica nadie corre.
# El patron con scope hace falta aparte: *eslint* no cubre @next/eslint-plugin-next.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@next/*

# La version de Node de `engines` se EXIGE, no se sugiere. Las instancias corren
# `node:22-alpine` y la CI lee `.nvmrc`; sin esto, una maquina con otra mayor
# instala y compila igual, y la divergencia solo aparece el dia que algo se
# comporta distinto en produccion. Preferimos que falle al instalar, que es
# barato y dice exactamente que pasa.
engine-strict=true
